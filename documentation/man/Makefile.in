top_srcdir = @top_srcdir@
srcdir     = @srcdir@
VPATH      = @srcdir@ 
SHELL      = /bin/sh

# Installation targets
#
prefix      = @prefix@
exec_prefix = @exec_prefix@
datarootdir = @datarootdir@
bindir      = @bindir@
libdir      = @libdir@
includedir  = @includedir@
docdir      = @docdir@
pdfdir      = @pdfdir@
mandir      = @mandir@
man1dir     = ${mandir}/man1
man1ext     = .1

INSTALL     = @INSTALL@

# Substitutions in the .man.in source files
#
HMMER_VERSION   = @HMMER_VERSION@
HMMER_DATE      = @HMMER_DATE@
HMMER_COPYRIGHT = @HMMER_COPYRIGHT@
HMMER_LICENSE   = @HMMER_LICENSE@
HMMER_URL       = @HMMER_URL@

# beautification magic stolen from git
#
QUIET_SUBDIR0 = +${MAKE} -C #space separator after -C
QUIET_SUBDIR1 =
ifndef V
	QUIET         = @
	QUIET_CC      = @echo '    ' CC $@;
	QUIET_GEN     = @echo '    ' GEN $@;
	QUIET_AR      = @echo '    ' AR $@;
	QUIET_SUBDIR0 = +@subdir=
	QUIET_SUBDIR1 = ; echo '    ' SUBDIR $$subdir; \
		        ${MAKE} -C $$subdir
endif


MANPAGES =  \
	hmmer.man         \
	hmmalign.man      \
	hmmbuild.man      \
	hmmclient.man     \
	hmmconvert.man    \
	hmmemit.man       \
	hmmfetch.man      \
	hmmlogo.man       \
	hmmpgmd.man       \
	hmmpgmd_shard.man \
	hmmpress.man      \
	hmmscan.man       \
	hmmsearch.man     \
	hmmsim.man        \
	hmmserver.man     \
	hmmstat.man       \
	jackhmmer.man     \
	phmmer.man        \
	nhmmer.man        \
	nhmmscan.man      \
	alimask.man
#	hmmc2\        # we don't install the hmmc2 executable or manpage automatically.

.PHONY:  all install uninstall clean distclean

all: ${MANPAGES}

${MANPAGES}: %.man : %.man.in
	${QUIET_GEN}sed \
	   -e 's|[@]HMMER_VERSION[@]|${HMMER_VERSION}|g'     \
	   -e 's|[@]HMMER_DATE[@]|${HMMER_DATE}|g'           \
	   -e 's|[@]HMMER_COPYRIGHT[@]|${HMMER_COPYRIGHT}|g' \
	   -e 's|[@]HMMER_LICENSE[@]|${HMMER_LICENSE}|g'     \
	   -e 's|[@]HMMER_URL[@]|${HMMER_URL}|g'             \
	   $< > $@

install: ${MANPAGES}
	if [ ! -d ${DESTDIR}${man1dir} ]; then ${INSTALL} -d ${DESTDIR}${man1dir}; fi
	for p in $(MANPAGES:%.man=%); do \
	   ${INSTALL} -m 0644 $$p.man ${DESTDIR}${man1dir}/$$p${man1ext} ;\
	done

uninstall:
	-for p in $(MANPAGES:%.man=%); do \
	   rm -f ${DESTDIR}${man1dir}/$$p${man1ext} ;\
	done

clean:
	-rm -f *~ *.man


distclean: clean
	-rm -f Makefile

