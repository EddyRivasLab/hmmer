top_srcdir     = @top_srcdir@
srcdir         = @srcdir@
VPATH          = @srcdir@
SHELL          = /bin/sh

# Installation targets
#
prefix      = @prefix@
exec_prefix = @exec_prefix@
datarootdir = @datarootdir@
bindir      = @bindir@
libdir      = @libdir@
includedir  = @includedir@
docdir      = @docdir@
pdfdir      = @pdfdir@
mandir      = @mandir@
man1dir     = ${mandir}/man1
man1ext     = .1

HMMER_VERSION   =  @HMMER_VERSION@
HMMER_DATE      = "@HMMER_DATE@"
HMMER_COPYRIGHT = "@HMMER_COPYRIGHT@"

INSTALL        = @INSTALL@
PANDOC         = pandoc
PANDOC_OPTS    = -f man -t latex --columns=80     
PANDOC_PROCESS = ${top_srcdir}/easel/devkit/pandoc_process.py

# beautification magic stolen from git
QUIET_SUBDIR0 = +${MAKE} -C #space separator after -C
QUIET_SUBDIR1 = 
ifndef V
	QUIET_SUBDIR0 = +@subdir=
	QUIET_SUBDIR1 = ; echo '    ' SUBDIR $$subdir; \
		        ${MAKE} -C $$subdir
endif

MANPAGES = \
	alimask.man        \
	hmmalign.man       \
	hmmbuild.man       \
	hmmconvert.man     \
	hmmemit.man        \
	hmmfetch.man       \
	hmmlogo.man        \
	hmmpgmd.man        \
	hmmpgmd_shard.man  \
	hmmpress.man       \
	hmmscan.man        \
	hmmsearch.man      \
	hmmsim.man         \
	hmmstat.man        \
	jackhmmer.man      \
	nhmmer.man         \
	nhmmscan.man       \
	phmmer.man      

MANPAGES_DAEMON = \
	hmmpgmd.man     \
	hmmpgmd_shard.man

MANPAGES_SERVER = \
	hmmclient.man   \
	hmmserver.man		\

EASEL_MANPAGES = \
	easel-afetch.man     \
	easel-afetchn.man    \
	easel-aindex.man     \
	easel-alicol.man     \
	easel-alimanip.man   \
	easel-alimap.man     \
	easel-alimerge.man   \
	easel-alipid.man     \
	easel-alirev.man     \
	easel-alishuf.man    \
	easel-alistat.man    \
	easel-compalign.man  \
	easel-compstruct.man \
	easel-construct.man  \
	easel-downsample.man \
	easel-filter.man     \
	easel-histplot.man   \
	easel-kmer.man       \
	easel-mask.man       \
	easel-printseq.man   \
	easel-reformat.man   \
	easel-seqrange.man   \
	easel-seqstat.man    \
	easel-sfetch.man     \
	easel-sfetchn.man    \
	easel-shuffle.man    \
	easel-sindex.man     \
	easel-ssdraw.man     \
	easel-synth.man      \
	easel-translate.man  \
	easel-weight.man

TEXFILES =\
	ack.tex          \
	copyright.tex    \
	daemon.tex       \
	formats.tex      \
	install.tex      \
	introduction.tex \
	main.tex         \
	pipeline.tex     \
	server.tex			\
	tabular.tex      \
	titlepage.tex    \
	titlepage_daemon.tex \
	tutorial.tex

.PHONY: pdf manpages clean distclean

pdf:    Userguide.pdf Daemon_userguide.pdf Server_userguide.pdf

# ${srcdir} prepended to TEXINPUTS, etc so we can build userguide in a
# build tree, with input files in source tree. Putting ${srcdir} before
# TEXINPUTs says to prefer our own files first.
#
Userguide.pdf: manpages ${TEXFILES}
	@for prog in pdflatex bibtex; do \
	  command -v $$prog >/dev/null 2>&1 || { echo >&2 "$$prog is required to build Userguide, but it's not installed. Aborting."; exit 1; } \
	done
	@echo "     LATEX Userguide.pdf  (see latex.log for output)"
	@TEXINPUTS=${srcdir}:${TEXINPUTS} pdflatex main                                >  latex.log 2>&1 
	@BIBINPUTS=${srcdir}:${BIBINPUTS} BSTINPUTS=${srcdir}:${BSTINPUTS} bibtex main >> latex.log 2>&1 
	@TEXINPUTS=${srcdir}:${TEXINPUTS} pdflatex main                                >> latex.log 2>&1 
	@TEXINPUTS=${srcdir}:${TEXINPUTS} pdflatex main                                >> latex.log 2>&1 
	@mv main.pdf Userguide.pdf

Daemon_userguide.pdf: manpages ${TEXFILES}
	@for prog in pdflatex bibtex; do \
	  command -v $$prog >/dev/null 2>&1 || { echo >&2 "$$prog is required to build Userguide, but it's not installed. Aborting."; exit 1; } \
	done
	@echo "     LATEX Daemon_userguide.pdf  (see latex.log for output)"
	@TEXINPUTS=${srcdir}:${TEXINPUTS} pdflatex daemon                              >  latex.log 2>&1 
	@BIBINPUTS=${srcdir}:${BIBINPUTS} BSTINPUTS=${srcdir}:${BSTINPUTS} bibtex main >> latex.log 2>&1 
	@TEXINPUTS=${srcdir}:${TEXINPUTS} pdflatex daemon                              >> latex.log 2>&1 
	@TEXINPUTS=${srcdir}:${TEXINPUTS} pdflatex daemon                              >> latex.log 2>&1 
	@mv daemon.pdf Daemon_userguide.pdf

Server_userguide.pdf: manpages ${TEXFILES}
	@for prog in pdflatex bibtex; do \
	  command -v $$prog >/dev/null 2>&1 || { echo >&2 "$$prog is required to build Userguide, but it's not installed. Aborting."; exit 1; } \
	done
	@echo "     LATEX Server_userguide.pdf  (see latex.log for output)"
	@TEXINPUTS=${srcdir}:${TEXINPUTS} pdflatex server                              >  latex.log 2>&1 
	@BIBINPUTS=${srcdir}:${BIBINPUTS} BSTINPUTS=${srcdir}:${BSTINPUTS} bibtex main >> latex.log 2>&1 
	@TEXINPUTS=${srcdir}:${TEXINPUTS} pdflatex server                              >> latex.log 2>&1 
	@TEXINPUTS=${srcdir}:${TEXINPUTS} pdflatex server                              >> latex.log 2>&1 
	@mv server.pdf Server_userguide.pdf

# manpages: convert man pages to LaTeX chapter in User Guide.
#    Uses `pandoc`, https://pandoc.org
manpages:
	@command -v ${PANDOC} >/dev/null 2>&1 || { echo >&2 "${PANDOC} is required to build user guides; it's not installed. Aborting."; exit 1; }
	${QUIET_SUBDIR0}../man               ${QUIET_SUBDIR1} all
	${QUIET_SUBDIR0}../../easel/miniapps ${QUIET_SUBDIR1} manpages
	@echo '%% Manual pages chapter automatically generated. Do not edit.'           > manpages.tex
	@echo '%% Manual pages chapter automatically generated. Do not edit.'           > manpages_daemon.tex
	@echo '%% Manual pages chapter automatically generated. Do not edit.'           > manpages_server.tex
	@echo '%% Easel miniapps manpage chapter automatically generated. Do not edit.' > easel_manpages.tex
	@for file in ${MANPAGES}; do\
	   test -f ../man/$$file || { echo >&2 "ERROR: ../man/$$file not found. Run 'make' in the top-level source dir first."; exit 1; } ;\
	   ${PANDOC} ${PANDOC_OPTS} ../man/$$file 2>/dev/null | ${PANDOC_PROCESS} >> manpages.tex ;\
	done
	@for file in ${EASEL_MANPAGES}; do\
	   test -f ../../easel/miniapps/$$file || { echo >&2 "ERROR: ../../easel/miniapps/$$file not found. Run 'make' in the top-level source dir first."; exit 1; } ;\
	   ${PANDOC} ${PANDOC_OPTS} ../../easel/miniapps/$$file 2>/dev/null | ${PANDOC_PROCESS} >> easel_manpages.tex ;\
	done
	@for file in ${MANPAGES_DAEMON}; do\
	   test -f ../man/$$file || { echo >&2 "ERROR: ../man/$$file not found. Run 'make' in the top-level source dir first."; exit 1; } ;\
	   ${PANDOC} ${PANDOC_OPTS} ../man/$$file 2>/dev/null | ${PANDOC_PROCESS} >> manpages_daemon.tex ;\
	done
	@for file in ${MANPAGES_SERVER}; do\
	   test -f ../man/$$file || { echo >&2 "ERROR: ../man/$$file not found. Run 'make' in the top-level source dir first."; exit 1; } ;\
	   ${PANDOC} ${PANDOC_OPTS} ../man/$$file 2>/dev/null | ${PANDOC_PROCESS} >> manpages_server.tex ;\
	done

# "make clean" removes artifacts of "make".
#   Here, that includes the auto-generated .tex files from .man pages,
#   and the output of pdflatex.
#
clean:
	${QUIET_SUBDIR0}inclusions   ${QUIET_SUBDIR1} clean
	-rm -f latex.log
	-rm -f x.log *~
	-rm -f main.aux   main.log   main.out   main.toc  main.bbl main.blg  main.brf 
	-rm -f daemon.aux daemon.log daemon.out daemon.toc
	-rm -f server.aux server.log server.out server.toc
	-rm -f manpages.tex easel_manpages.tex manpages_daemon.tex manpages_server.tex
	-rm -f Userguide.pdf
	-rm -f Daemon_userguide.pdf
	-rm -f Server_userguide.pdf

# "make distclean" removes artifacts of "./configure"
#
distclean: clean
	${QUIET_SUBDIR0}inclusions   ${QUIET_SUBDIR1} distclean
	-rm -f copyright.tex
	-rm -f titlepage.tex titlepage_daemon.tex titlepage_server.tex
	-rm -f Makefile

