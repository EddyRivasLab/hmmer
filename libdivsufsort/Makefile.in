# VPATH and shell configuration
top_srcdir = @top_srcdir@
srcdir     = @srcdir@
VPATH      = @srcdir@
SHELL      = /bin/sh

# options
CC             = @CC@
CFLAGS         = @CFLAGS@
SSE_CFLAGS     = @SSE_CFLAGS@
VMX_CFLAGS     = @VMX_CFLAGS@
PTHREAD_CFLAGS = @PTHREAD_CFLAGS@
CPPFLAGS       = @CPPFLAGS@
AR             = @AR@ rc
RANLIB         = @RANLIB@

# beautification magic
ifndef V
	QUIET         = @
	QUIET_CC      = @echo '    ' CC $@;
	QUIET_AR      = @echo '    ' AR $@;
endif

all:  libdivsufsort.a

libdivsufsort.a: divsufsort.o
	${QUIET_AR}${AR} libdivsufsort.a divsufsort.o
	${QUIET}${RANLIB} libdivsufsort.a
	${QUIET}chmod 644 libdivsufsort.a

divsufsort.o: divsufsort.c divsufsort.h
	${QUIET_CC}${CC} -I. ${CFLAGS} ${SSE_CFLAGS} ${VMX_CFLAGS} ${PTHREAD_CFLAGS} ${CPPFLAGS} -o $@ -c $<

clean:
	${QUIET}-rm -f libdivsufsort.a divsufsort.o

distclean:
	${QUIET}-rm -f libdivsufsort.a divsufsort.o Makefile divsufsort.h
